# Copia este archivo como .env y reemplaza los valores.
# Nunca subas tu .env real a Git.

SEPOLIA_RPC_URL=https://tu-rpc-de-sepolia
SEPOLIA_PRIVATE_KEY=0xTU_PRIVATE_KEY_DE_PRUEBAS

# Solo hace falta para verificar contratos en Etherscan (leccion 18).
# La API key se crea gratis en https://etherscan.io/myapikey
ETHERSCAN_API_KEY=TU_API_KEY_DE_ETHERSCAN
